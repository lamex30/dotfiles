# generated by theme.py from the wallpaper
[global]
font = JetBrainsMono Nerd Font 11
width = 340
frame_width = 2
frame_color = "#db8095"
separator_color = frame
corner_radius = 0
padding = 12
horizontal_padding = 14
show_indicators = no
mouse_left_click = do_action, close_current
mouse_middle_click = close_all
mouse_right_click = close_current

[urgency_low]
background = "#141414"
foreground = "#e0e0e0"
highlight = "#db8095"

[urgency_normal]
background = "#141414"
foreground = "#e0e0e0"
highlight = "#db8095"

[urgency_critical]
background = "#141414"
foreground = "#ef6c7c"
frame_color = "#ef6c7c"
highlight = "#ef6c7c"

[wired_sound]
summary = "*"
script = ~/.config/dunst/sound.sh
